# ─────────────────────────────────────────────────────────────────────────────
# Environment variables: the app's private settings (passwords, API keys).
#
# This file is a BLANK TEMPLATE and is safe to commit. To use it:
#   1. Copy it to a file named .env.local (that name is never committed to git).
#   2. Fill in the values in .env.local.
#   3. Put the same values in Vercel: Project → Settings → Environment Variables.
#
# Anything starting with NEXT_PUBLIC_ is visible in the browser, so only
# non-secret values get that prefix. Everything else stays on the server.
#
# Phase 0–2 need none of these. See docs/SETUP.md for where each one comes from.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (database, sign-in, live updates). Needed from Phase 3/4.
# Supabase dashboard → your project → Connect / Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Full database access: never prefix with NEXT_PUBLIC_, never share it.
SUPABASE_SECRET_KEY=

# Encrypts saved ESPN cookies before they're stored. Needed from Phase 9.
# Generate one with:  openssl rand -base64 32
ESPN_COOKIE_ENCRYPTION_KEY=

# Optional: Claude writes friendly Start/Sit explanations and play summaries (Phase 6–7).
# console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=

# Live-data worker (worker/, deployed separately on Railway; see worker/README.md).
# Supabase "Session pooler" connection string. Server only, never in the browser.
DATABASE_URL=
# Optional worker tuning (defaults: false, 120, 8).
POLL_ALL_LIVE_GAMES=
ESPN_MAX_REQUESTS_PER_MINUTE=
LIVE_POLL_SECONDS=

# Optional: pin the installable app's version id (normally a new one per build; see next.config.ts).
PWA_BUILD_ID=
